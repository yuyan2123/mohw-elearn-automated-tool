{
  "manifest_version": 3,
  "name": "e 學園學習助手",
  "version": "1.0.8",
  "description": "查看平臺閱讀時數，並在正常結算後接續教材。",
  "permissions": ["storage"],
  "action": {
    "default_title": "e 學園學習助手",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://elearn.hrd.gov.tw/info/*", "https://mohw.elearn.hrd.gov.tw/info/*"],
      "js": ["study.js", "overview.js"]
    },
    {
      "matches": ["https://mohw.elearn.hrd.gov.tw/learn/mooc_sysbar.php*"],
      "all_frames": true,
      "js": ["study.js", "intro.js", "classroom.js"],
      "css": ["panel.css"]
    },
    {
      "matches": ["https://mohw.elearn.hrd.gov.tw/learn/*"],
      "css": ["intro.css"]
    },
    {
      "matches": ["https://www.youtube.com/embed/*"],
      "all_frames": true,
      "js": ["embedded-resource.js", "video.js"]
    },
    {
      "matches": ["https://lcms.elearn.hrd.gov.tw/asset/play/*"],
      "all_frames": true,
      "js": ["embedded-resource.js", "file-viewer.js"]
    }
  ]
}
